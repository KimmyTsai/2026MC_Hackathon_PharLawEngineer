# ---- Gemini (Google AI Studio) ----
GEMINI_API_KEY=
# Model IDs: confirm the exact strings in AI Studio before relying on them.
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_PRO_MODEL=
# Legacy single-model var, still read by scripts/test-ai-studio.mjs
GEMINI_MODEL=gemini-3-flash-preview

# ---- Vertex AI (only if switching away from AI Studio; use ADC, not a key) ----
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ---- Runtime ----
# replay = deterministic fixtures from data/scenarios (demo default); live = real providers
# 免費方案每個模型每天只有 20 次 generate_content 請求
# cache=命中錄音檔就重播，否則呼叫並錄下來（預設）｜live=每次都呼叫
# replay=只用錄音檔｜off=完全不呼叫模型，改用確定性規劃
AGENT_MODE=cache
CASSETTE=demo_wed

MODE=replay
SCENARIO=demo_wed
REPLAY_SPEED=1.0
PORT=3000

# ---- Live providers (each one falls back to "unavailable", never to fixtures) ----
# Central Weather Administration open data platform
CWA_API_KEY=
# TDX (Tainan bus ETA, YouBike station status) — confirm dataset IDs at implementation time
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# ---- On-device model for mobility-state handling (M8) ----
USE_GEMMA=false
OLLAMA_MODEL=
OLLAMA_HOST=http://127.0.0.1:11434
