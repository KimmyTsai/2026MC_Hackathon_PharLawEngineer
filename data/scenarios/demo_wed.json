{
  "name": "demo_wed",
  "date": "2026-09-23",
  "timezone": "Asia/Taipei",
  "start_at": "07:45",
  "description": "Canonical demo: Wednesday 09:30 presentation at CSIE-4263. A crutches-profile student commutes 2.2 km from off campus, then walks an accessible route inside campus. A maintenance notice closes the west elevator; rain, zero bikes and a flood advisory move the departure earlier; by 08:35 the student has still not left.",
  "user": {
    "profile": "crutches",
    "home_node": "HOME_OFFCAMPUS",
    "campus_home_node": "DORM_A",
    "email": "student@example.edu",
    "note": "Synthetic identity and location. Mobility state is handled locally (see CLAUDE.md 2.5)."
  },
  "schedule": "data/scenarios/demo_schedule.json",
  "mailbox": [
    "mail_001",
    "mail_002",
    "mail_003"
  ],
  "baseline_signals": [
    {
      "kind": "rain",
      "provider": "cwa_fixture",
      "at": "07:45",
      "valid_for_minutes": 60,
      "area": "台南市東區",
      "value": {
        "mm_per_hr": 0,
        "rain_from": null,
        "description": "多雲"
      }
    },
    {
      "kind": "bike_availability",
      "provider": "youbike_fixture",
      "at": "07:45",
      "valid_for_minutes": 10,
      "area": "YB_ST_HOME",
      "value": {
        "station": "YB_ST_HOME",
        "bikes": 7,
        "docks": 12
      }
    },
    {
      "kind": "bus_eta",
      "provider": "tdx_fixture",
      "at": "07:45",
      "valid_for_minutes": 5,
      "area": "BUS_STOP_HOME",
      "value": {
        "stop": "BUS_STOP_HOME",
        "route": "藍幹線",
        "eta_minutes": 9,
        "ride_minutes": 8,
        "low_floor": true
      }
    },
    {
      "kind": "flood",
      "provider": "flood_fixture",
      "at": "07:45",
      "valid_for_minutes": 30,
      "area": "大學路",
      "value": {
        "level": "none",
        "corridor": "大學路"
      }
    },
    {
      "kind": "air_quality",
      "provider": "aqi_fixture",
      "at": "07:45",
      "valid_for_minutes": 60,
      "area": "台南市東區",
      "value": {
        "aqi": 52,
        "status": "moderate"
      }
    },
    {
      "kind": "departure_state",
      "provider": "device_fixture",
      "at": "07:45",
      "valid_for_minutes": 15,
      "value": {
        "departed": false,
        "at_node": "HOME_OFFCAMPUS"
      }
    }
  ],
  "events": [
    {
      "t": "07:50",
      "type": "day_start",
      "payload": {},
      "expect": "09:30 報告的初次計畫：出發時間、ETA、下次檢查時間"
    },
    {
      "t": "08:05",
      "type": "notice_received",
      "payload": {
        "mail_id": "mail_003"
      },
      "expect": "公告讓西側電梯停用；館內路段改走東側電梯"
    },
    {
      "t": "08:15",
      "type": "weather_update",
      "payload": {
        "rain_from": "08:30",
        "mm_per_hr": 15,
        "description": "短時強降雨"
      },
      "expect": "優先有頂蓋路段；YouBike 被加重懲罰"
    },
    {
      "t": "08:15",
      "type": "bike_status_update",
      "payload": {
        "station": "YB_ST_HOME",
        "bikes": 0,
        "docks": 19
      },
      "expect": "YouBike 變成不可行，而不只是比較慢"
    },
    {
      "t": "08:16",
      "type": "flood_warning",
      "payload": {
        "corridor": "大學路",
        "level": "advisory",
        "reason": "積水 10cm"
      },
      "expect": "暴露在積水路段的步行與騎乘方案因安全性被排除"
    },
    {
      "t": "08:22",
      "type": "bus_eta_update",
      "payload": {
        "stop": "BUS_STOP_HOME",
        "route": "藍幹線",
        "eta_minutes": 6,
        "ride_minutes": 7,
        "low_floor": true
      },
      "expect": "選定低地板公車；出發時間提前"
    },
    {
      "t": "08:25",
      "type": "user_not_departed",
      "payload": {
        "at_node": "HOME_OFFCAMPUS"
      },
      "expect": "出發時間窗即將關閉的提醒（此時仍可行）"
    },
    {
      "t": "08:27",
      "type": "report_submitted",
      "payload": {
        "photo": "data/photos/ramp_blocked.jpg",
        "node_hint": "RAMP_07",
        "confidence_hint": "low"
      },
      "expect": "low-confidence photo reading asks the user instead of silently overriding the graph"
    },
    {
      "t": "08:35",
      "type": "user_not_departed",
      "payload": {
        "at_node": "HOME_OFFCAMPUS"
      },
      "expect": "已錯過最晚出發時間：遲到風險警告，並產生寄給助教的信件草稿（未確認不得寄出）"
    }
  ]
}
